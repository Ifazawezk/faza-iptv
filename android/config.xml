<?xml version='1.0' encoding='utf-8'?>
<widget id="io.github.ifazawezk.fazaiptv" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Faza IPTV</name>
    <description>Free, open-source IPTV player for M3U playlists and Xtream Codes.</description>
    <author href="https://github.com">Faza IPTV contributors</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- Load the UI from file:// so the player may read playlists/streams from any IPTV server
         (same idea as the desktop app). -->
    <preference name="AndroidInsecureFileModeEnabled" value="true" />
    <preference name="OverrideUserAgent" value="VLC/3.0.20 LibVLC/3.0.20" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="BackgroundColor" value="0xff0b0f17" />
    <preference name="Orientation" value="default" />
    <preference name="AndroidWindowSplashScreenBackground" value="#0b0f17" />

    <platform name="android">
        <!-- Most IPTV streams are plain http:// -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
        <icon src="res/icon.png" />

        <!-- Android TV / Google TV / Fire TV: show in the TV launcher, no touchscreen needed -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-feature android:name="android.software.leanback" android:required="false" />
            <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
        </config-file>
        <config-file target="AndroidManifest.xml" parent="/manifest/application/activity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </config-file>
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:banner="@drawable/tv_banner" />
        </edit-config>
        <resource-file src="res/tv_banner.png" target="app/src/main/res/drawable/tv_banner.png" />
    </platform>
</widget>
